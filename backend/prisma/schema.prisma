generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SALES_EXECUTIVE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum DealStage {
  DISCOVERY        // shown as "New" in the UI
  QUALIFICATION
  NEEDS_ANALYSIS
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum MeetingType {
  ONLINE
  IN_PERSON
  PHONE
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  CUSTOMER
  TASK
  DEAL
  MEETING
  SYSTEM
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  customers  Customer[]
  leads      Lead[]
  deals      Deal[]
  tasks      Task[]
  meetings   Meeting[]
  activities Activity[]
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  role         Role           @default(SALES_EXECUTIVE)
  avatar       String?
  phone        String?
  department   String?        @default("Sales")
  status       String         @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Tenant + hierarchy (nullable so existing rows survive db push; see prisma/backfill-tenancy.ts)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  managerId      String?       // set only for SALES_EXECUTIVE -> their MANAGER
  manager        User?         @relation("TeamHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  teamMembers    User[]        @relation("TeamHierarchy")

  // Relations
  assignedCustomers Customer[]     @relation("AssignedCustomers")
  createdCustomers  Customer[]     @relation("CreatedCustomers")
  assignedLeads     Lead[]         @relation("AssignedLeads")
  assignedDeals     Deal[]         @relation("AssignedDeals")
  assignedTasks     Task[]         @relation("AssignedTasks")
  createdTasks      Task[]         @relation("CreatedTasks")
  hostedMeetings    Meeting[]      @relation("HostedMeetings")
  notifications     Notification[]
  activities        Activity[]
  refreshTokens     RefreshToken[]

  @@index([email])
  @@index([role])
  @@index([organizationId])
  @@index([managerId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Customer {
  id          String         @id @default(uuid())
  name        String
  email       String
  phone       String?
  company     String?
  industry    String?
  budget      Float          @default(0)
  interest    String?
  leadScore   String?        // "Hot Lead 🔥", "Medium Lead 🟡", "Low Lead 🔵"
  address     String?
  city        String?
  state       String?
  country     String?        @default("India")
  status      CustomerStatus @default(ACTIVE)
  notes       String?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?         @relation("AssignedCustomers", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?         @relation("CreatedCustomers", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  leads       Lead[]
  deals       Deal[]
  tasks       Task[]
  meetings    Meeting[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
  @@index([status])
  @@index([assignedToId])
}

model Lead {
  id           String      @id @default(uuid())
  title        String
  contactName  String
  email        String
  phone        String?
  company      String?
  value        Float       @default(0)
  stage        LeadStage   @default(NEW)
  priority     Priority    @default(MEDIUM)
  notes        String?
  followUpDate DateTime?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?       @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)

  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tasks        Task[]

  @@index([organizationId])
  @@index([stage])
  @@index([assignedToId])
  @@index([customerId])
}

model Deal {
  id           String      @id @default(uuid())
  title        String
  value        Float       @default(0)
  stage        DealStage   @default(DISCOVERY)
  probability  Int         @default(20) // Percentage 0 - 100
  closingDate  DateTime?
  nextStep     String?
  description  String?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?       @relation("AssignedDeals", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tasks        Task[]

  @@index([organizationId])
  @@index([stage])
  @@index([customerId])
  @@index([assignedToId])
}

model Task {
  id          String      @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?
  priority    Priority    @default(MEDIUM)
  status      TaskStatus  @default(PENDING)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?      @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdById  String?
  createdBy    User?      @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: SetNull)

  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  leadId       String?
  lead         Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)

  dealId       String?
  deal         Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
}

model Meeting {
  id          String        @id @default(uuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  location    String?
  type        MeetingType   @default(ONLINE)
  status      MeetingStatus @default(SCHEDULED)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  hostId      String?
  host        User?         @relation("HostedMeetings", fields: [hostId], references: [id], onDelete: SetNull)

  customerId  String?
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([organizationId])
  @@index([startTime])
  @@index([hostId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
}

model Activity {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // e.g. "CUSTOMER_CREATED", "LEAD_STAGE_CHANGED", "DEAL_CLOSED"
  entityType String   // "Customer", "Lead", "Deal", "Task", "Meeting", "User"
  entityId   String?
  details    String   // Human-readable summary
  createdAt  DateTime @default(now())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}
